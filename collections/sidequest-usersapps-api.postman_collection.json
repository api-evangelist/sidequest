        {
          "id": "53fefe25-83ee-4a49-8d85-dbf6d4946fc6",
          "name": "Get User App Achievements",
          "request": {
            "name": "Get User App Achievements",
            "description": {
              "content": "Gets a listing of achievements a user has unlocked for an app\n\n```\nRequired Scopes:\n-user.app_achievements.read\n```",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "users",
                ":route_users_id",
                "apps",
                ":apps_id",
                "achievements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "Skips a number of objects from the start of the list.  Used for paging."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Limits the number of objects returned."
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Filters the returned rows by the name of the achievement.  The % (url encoded as %25) can be included in the string as a wildcard."
                },
                {
                  "disabled": false,
                  "key": "sortOn",
                  "value": "<string>",
                  "description": "Sorts the returned object by one or more parameters.  Multiple values can be separated by a comma for sorting on multiple fields.\n * created_at - The timestamp when the achievement was created\n * name - The name of the achievement\n * status - The status of the achievement\n"
                },
                {
                  "disabled": false,
                  "key": "descending",
                  "value": "<string>",
                  "description": "Orders the results in descending order based on the sortOn specified.  If there are multiple sortOns specified, multiple values can be separated by a comma for each corresponding sortOn."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "route_users_id",
                  "description": "(Required) The unique user ID or \"me\"\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "apps_id",
                  "description": "(Required) The unique app ID or \"me\"\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
